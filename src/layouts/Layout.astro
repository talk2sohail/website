---
import { getImage } from "astro:assets";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import profile from "../assets/profile.jpg";

const SITE_NAME = "Md Sohail";
const SITE_DESCRIPTION =
  "Md Sohail's blog on backend systems, databases, distributed systems and cloud native applications.";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  publishDate?: Date;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = "website",
  publishDate,
} = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: profile, width: 600, format: "jpeg" });
const imageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Md Sohail | Blog & TIL"
      href={new URL("/rss.xml", Astro.site)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    {
      publishDate && (
        <meta
          property="article:published_time"
          content={publishDate.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@talk2sohail1001" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script is:inline defer src="https://umami.mdsohail.dev/script.js" data-website-id="ed88fb31-9529-440b-97f9-02d801a5812f"></script>
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      if (theme === "light") {
        document.documentElement.classList.add("light-mode");
      } else {
        document.documentElement.classList.remove("light-mode");
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --background: #16161e;
    --foreground: #c0caf5;
    --accent1: #7aa2f7;
    --accent2: #bb9af7;
    --card-background: #1a1b26;
    --code-background: #1a1b26;
    --icon-color-dark: #ffd700;
    --icon-color-light: #333333;
    --border-color: #2f334d;
  }
  :root.light-mode {
    --background: #ffffff;
    --foreground: #333333;
    --accent1: #007acc;
    --accent2: #8e44ad;
    --card-background: #f5f5f5;
    --code-background: #f6f8fa;
    --border-color: #e1e4e8;
  }
  body {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }
  @media (max-width: 768px) {
    body {
      padding: 1rem;
    }
  }
  html {
    font-family: "IBM Plex Sans", sans-serif;
    background: var(--background);
    color: var(--foreground);
    background-size: 224px;
    font-size: 102%;
    letter-spacing: 0.5px;
  }
  html.theme-transitions-enabled {
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  /* Typography & Article Styles */
  article {
    line-height: 1.6;
    font-size: 1.1rem;
  }
  article p {
    margin-bottom: 1.25rem;
  }
  article h1,
  article h2,
  article h3,
  article h4 {
    color: var(--foreground);
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  article h1 {
    font-size: 2.2rem;
  }
  article h2 {
    font-size: 1.8rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }
  article h3 {
    font-size: 1.4rem;
  }

  article ul,
  article ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  article li {
    margin-bottom: 0.5rem;
  }
  article blockquote {
    border-left: 4px solid var(--accent1);
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1rem;
    background: var(--card-background);
    font-style: italic;
    border-radius: 0 4px 4px 0;
  }
  article a {
    color: var(--accent1);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom 0.2s ease;
  }
  article a:hover {
    border-bottom-color: var(--accent1);
  }

  /* Code Blocks */
  code {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9em;
    background: var(--card-background);
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }
  :root.light-mode code {
    background: rgba(0, 0, 0, 0.06);
  }
  :root.light-mode pre code {
    background: transparent;
  }
  pre {
    position: relative;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.9rem;
    background: var(--code-background);
    border: 1px solid var(--border-color);
    margin: 2rem 0;
    line-height: 1.5;
  }
  pre code {
    background: transparent;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  /* Image styling */
  article img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  article p:has(img) {
    max-width: 100%; /* Relaxed constraint */
    margin: 2rem auto;
    text-align: center;
  }
  article p:has(img) + p {
    margin-top: -1rem; /* Caption positioning */
    text-align: center;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  /* Copy Button (anchored to a wrapper so it stays put when code scrolls) */
  .code-block {
    position: relative;
  }
  .code-block .copy-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background-color: transparent;
    color: var(--foreground);
    border: none;
    padding: 0.3rem;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .code-block:hover .copy-button,
  .code-block .copy-button:focus-visible {
    opacity: 1;
  }
  /* Touch screens have no hover, so keep the button visible there. */
  @media (hover: none) {
    .code-block .copy-button {
      opacity: 0.7;
    }
  }
  :root.light-mode .code-block .copy-button {
    color: #333;
    background-color: transparent;
  }

  /* Page-level headings and list-page chrome */
  main > h1 {
    font-size: 2.2rem;
    font-weight: bolder;
    margin-bottom: 1rem;
  }
  .links a {
    color: var(--accent1);
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .dotted-line {
    border: none;
    height: 1px;
    background-image: radial-gradient(
      circle,
      var(--foreground) 1px,
      transparent 1px
    );
    background-size: 5px 1px;
    background-repeat: repeat-x;
    margin: 1.5rem 0;
  }

  /* GitHub-style alerts: > [!NOTE], [!TIP], [!IMPORTANT], [!WARNING], [!CAUTION] */
  .markdown-alert {
    --alert-color: var(--accent1);
    border-left: 4px solid var(--alert-color);
    background: var(--card-background);
    border-radius: 0 4px 4px 0;
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
  }
  .markdown-alert > :last-child {
    margin-bottom: 0;
  }
  .markdown-alert-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: var(--alert-color);
  }
  .markdown-alert-title svg {
    fill: currentColor;
  }
  .markdown-alert-tip {
    --alert-color: #3fb950;
  }
  .markdown-alert-important {
    --alert-color: var(--accent2);
  }
  .markdown-alert-warning {
    --alert-color: #d29922;
  }
  .markdown-alert-caution {
    --alert-color: #f85149;
  }
  :root.light-mode .markdown-alert-tip {
    --alert-color: #1a7f37;
  }
  :root.light-mode .markdown-alert-warning {
    --alert-color: #9a6700;
  }
  :root.light-mode .markdown-alert-caution {
    --alert-color: #cf222e;
  }

  /* Shiki dual themes (see astro.config.mjs) */
  .astro-code,
  .astro-code span {
    color: var(--shiki-dark);
  }
  :root.light-mode .astro-code,
  :root.light-mode .astro-code span {
    color: var(--shiki-light);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const themeToggle: HTMLElement | null =
      document.querySelector(".theme-toggle");
    const html: HTMLHtmlElement | null = document.querySelector("html");

    const sunIcon = `
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="5" fill="currentColor"/>
        <path d="M12 1V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M12 21V23" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M4.22 4.22L5.64 5.64" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M18.36 18.36L19.78 19.78" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M1 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M21 12H23" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M4.22 19.78L5.64 18.36" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M18.36 5.64L19.78 4.22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;

    const moonIcon = `
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
    `;

    if (html && themeToggle) {
      type Theme = "light" | "dark";

      const applyTheme = (theme: Theme): void => {
        if (theme === "light") {
          html.classList.add("light-mode");
          themeToggle.innerHTML = moonIcon;
        } else {
          html.classList.remove("light-mode");
          themeToggle.innerHTML = sunIcon;
        }
      };

      themeToggle.addEventListener("click", () => {
        const currentTheme: Theme = html.classList.contains("light-mode")
          ? "light"
          : "dark";
        const newTheme: Theme = currentTheme === "light" ? "dark" : "light";
        localStorage.setItem("theme", newTheme);
        applyTheme(newTheme);
      });

      // The inline script in <head> has already picked the theme; just sync the icon.
      applyTheme(html.classList.contains("light-mode") ? "light" : "dark");
    }

    const codeBlocks = document.querySelectorAll("pre");

    const copyIcon = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
      </svg>
    `;

    const copiedIcon = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
    `;

    codeBlocks.forEach((block) => {
      const button = document.createElement("button");
      button.innerHTML = copyIcon;
      button.classList.add("copy-button");
      button.type = "button";
      button.setAttribute("aria-label", "Copy code");
      const wrapper = document.createElement("div");
      wrapper.classList.add("code-block");
      block.replaceWith(wrapper);
      wrapper.append(block, button);

      button.addEventListener("click", () => {
        const code = block.querySelector("code")?.innerText;
        if (code) {
          navigator.clipboard.writeText(code).then(() => {
            button.innerHTML = copiedIcon;
            setTimeout(() => {
              button.innerHTML = copyIcon;
            }, 2000);
          });
        }
      });
    });
  });
</script>
