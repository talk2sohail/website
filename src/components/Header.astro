---
// src/components/Header.astro
const links = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blogs" },
  { href: "/til/", label: "TIL" },
  { href: "/contact/", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));

// Only the home page uses the site name as its <h1>; other pages have their own.
const TitleTag = path === "/" ? "h1" : "p";
---

<header>
  <div class="header-content">
    <TitleTag class="site-title"><a href="/">Md Sohail</a></TitleTag>
    <nav aria-label="Main">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class:list={{ active: isActive(href) }}
            aria-current={isActive(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
  <button class="theme-toggle" type="button" aria-label="Toggle dark mode"></button>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .header-content {
    display: flex;
    flex-direction: column;
  }
  .site-title {
    font-size: 2.8rem;
    font-weight: bolder;
    margin: 0.67em 0 1rem;
    line-height: 1.2;
  }
  .site-title a {
    color: inherit;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    nav {
      gap: 1rem;
    }
  }
  nav a {
    text-decoration: none;
    color: var(--accent1);
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
  }
  nav a:hover,
  nav a.active {
    border-bottom-color: var(--accent1);
  }
  .theme-toggle {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--icon-color-dark);
    transition: transform 0.3s ease;
  }
  html.light-mode .theme-toggle {
    color: var(--icon-color-light);
  }
  .theme-toggle:hover {
    transform: scale(1.1);
  }
</style>
