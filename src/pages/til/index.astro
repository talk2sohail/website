---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../utils/posts";

const posts = await getPosts("til");
---

<Layout
  title="Today I Learned"
  description="Bite-sized notes on things I've learned over time."
>
  <Header />
  <main>
    <h1>Today I Learned</h1>
    <p>A collection of bite sized notes on various topics that I’ve learned over time.</p>
    <p class="links">
      <a href="/rss.xml">Subscribe via RSS</a> · <a href="/tags/">Browse by tag</a>
    </p>
    <hr class="dotted-line" />
    <PostList posts={posts} />
  </main>
  <Footer />
</Layout>
